{
  "version": 2,
  "builds": [
    {
      "src": "metrito_config/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    },
    {
      "src": "docs/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "metrito_config/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "/docs/$1"
    }
  ]
}
